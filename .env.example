# Amazon Bedrock credentials (IAM user with bedrock:InvokeModel / InvokeModelWithResponseStream)
CLAUDE_AWS_ACCESS_KEY=
CLAUDE_AWS_SECRET_KEY=
CLAUDE_AWS_REGION=ap-southeast-1
# Bedrock model id or inference-profile ARN for Claude Sonnet 5.5 (or Haiku 5.5)
CLAUDE_AWS_MODEL=arn:aws:bedrock:<region>:<account>:inference-profile/global.anthropic.claude-sonnet-5-5
# Optional: faster model for history classification + "Ask Nightlight" chat (falls back to CLAUDE_AWS_MODEL)
CLAUDE_AWS_FAST_MODEL=global.anthropic.claude-haiku-5-5
